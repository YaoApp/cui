{
  "name": "@yaoapp/celadon",
  "version": "1.0.0",
  "description": "CUI 2.0 design baseline: design tokens, icon system, i18n, specification pages and the app shell.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YaoApp/cui.git",
    "directory": "packages/celadon"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "icons",
    "i18n",
    "vite"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "app",
    "design",
    "scripts",
    "vite.config.ts",
    "CONVENTIONS.md",
    "THIRD-PARTY-NOTICES.md",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node scripts/check-i18n.mjs && node scripts/check-readme-values.mjs && node scripts/check-tokens.mjs && node scripts/check-generated.mjs && node scripts/check-css-conventions.mjs",
    "test": "node scripts/tests/run.mjs",
    "prepare": "vite build",
    "prepack": "vite build"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  }
}
