{
  "name": "@yaoapp/cui",
  "version": "2.0.0",
  "packageManager": "pnpm@12.8.1",
  "description": "A chat UI framework and design baseline for building AI native applications on Yao App Engine.",
  "license": "Yao License 1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YaoApp/cui.git",
    "directory": "packages/celadon"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "icons",
    "i18n",
    "vite"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "files": [
    "dist",
    "app",
    "design",
    "scripts",
    "vite.config.ts",
    "CONVENTIONS.md",
    "THIRD-PARTY-NOTICES.md",
    "README.md",
    "!app/logs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node scripts/run-logged.mjs gates pnpm run check:run",
    "check:run": "node scripts/check-i18n.mjs && node scripts/check-i18n-types.mjs && node scripts/check-readme-values.mjs && node scripts/check-tokens.mjs && node scripts/check-generated.mjs && node scripts/check-css-conventions.mjs && node scripts/check-plan-md.mjs && node scripts/check-app-layout.mjs && node scripts/check-effect-url-write.mjs && node scripts/check-base-components.mjs && node scripts/check-import-boundaries.mjs && node scripts/check-doc-references.mjs",
    "build:i18n": "node scripts/build-i18n-types.mjs",
    "test": "node scripts/run-logged.mjs unit vitest run",
    "test:watch": "vitest",
    "test:checkers": "node scripts/run-logged.mjs checkers node scripts/tests/run.mjs",
    "test:browser": "node scripts/run-logged.mjs browser playwright test",
    "test:persona": "node scripts/run-persona.mjs",
    "test:all": "node scripts/run-logged.mjs all pnpm run test:all:run",
    "test:all:run": "pnpm lint && pnpm check && pnpm test:checkers && pnpm test && pnpm test:browser && pnpm build && pnpm test:persona",
    "prepack": "vite build",
    "docs:stamp": "node scripts/stamp-docs.mjs",
    "docs:stamp:check": "node scripts/stamp-docs.mjs --check",
    "lint": "node scripts/run-logged.mjs lint pnpm run lint:run",
    "lint:run": "stylelint \"app/src/**/*.less\" && eslint . && tsc --noEmit",
    "lint:styles": "stylelint \"app/src/**/*.less\"",
    "lint:js": "eslint .",
    "lint:types": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "less": "^4.9.1",
    "postcss-less": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-less": "^4.1.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "i18next": "^26.4.2",
    "react-i18next": "^17.0.15",
    "react-router": "^8.4.0"
  }
}
